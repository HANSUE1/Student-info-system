<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".StudentFormActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationContentDescription="Back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
        app:title="Add student" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_required"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:max="4"
        app:trackStopIndicatorSize="0dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/FormSection"
                        android:accessibilityHeading="true"
                        android:text="Identification"
                        tools:targetApi="p" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/field_student_no"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Student number"
                        app:endIconContentDescription="Valid"
                        app:endIconDrawable="@drawable/ic_check"
                        app:endIconMode="custom"
                        app:endIconTint="@color/success"
                        app:helperText="Format YYYY-NNNNNNN, e.g. 2025-0012345">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_student_no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789-"
                            android:imeOptions="actionNext"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/FormSection"
                        android:accessibilityHeading="true"
                        android:text="Full name"
                        tools:targetApi="p" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/field_last_name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Last name"
                        app:counterEnabled="true"
                        app:counterMaxLength="50"
                        app:endIconContentDescription="Valid"
                        app:endIconDrawable="@drawable/ic_check"
                        app:endIconMode="custom"
                        app:endIconTint="@color/success"
                        app:helperText="Letters, spaces and - ' . only">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_last_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/field_first_name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="First name"
                        app:counterEnabled="true"
                        app:counterMaxLength="50"
                        app:endIconContentDescription="Valid"
                        app:endIconDrawable="@drawable/ic_check"
                        app:endIconMode="custom"
                        app:endIconTint="@color/success"
                        app:helperText="Letters, spaces and - ' . only">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_first_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/field_middle_name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Middle name (optional)"
                        app:counterEnabled="true"
                        app:counterMaxLength="50"
                        app:helperText="Letters, spaces and - ' . only">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_middle_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/FormSection"
                        android:accessibilityHeading="true"
                        android:text="Academic info"
                        tools:targetApi="p" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/field_year_level"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Year level">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/edit_year_level"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/year_levels" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/field_specialization"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Specialization (optional)"
                        app:counterEnabled="true"
                        app:counterMaxLength="60"
                        app:helperText="Leave blank if none">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_specialization"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="text|textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        android:minHeight="56dp"
        android:text="Save student"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart" />
</LinearLayout>
